# Optional. When set, the quote form POSTs JSON to this URL (e.g. a Formspree,
# Basin, or your own serverless endpoint) before offering the WhatsApp handoff.
# Leave empty to use the WhatsApp handoff only. Never put secrets here: Vite
# exposes VITE_* variables to the browser.
VITE_FORM_ENDPOINT=

# Public site origin used for canonical/OG URLs at build time.
VITE_SITE_URL=https://effectiveinsure.com
